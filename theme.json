{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"defaultPalette": false,
			"palette": [
				{ "slug": "base", "name": "Background", "color": "#0E0E0F" },
				{ "slug": "base-deep", "name": "Background deep", "color": "#09090A" },
				{ "slug": "band", "name": "Band", "color": "#141416" },
				{ "slug": "card", "name": "Card", "color": "#161618" },
				{ "slug": "border", "name": "Border", "color": "#26262A" },
				{ "slug": "contrast", "name": "Text", "color": "#EDE8DF" },
				{ "slug": "text-2", "name": "Text secondary", "color": "#CFC9BF" },
				{ "slug": "muted", "name": "Muted", "color": "#A8A29A" },
				{ "slug": "accent", "name": "Accent red", "color": "#A3222B" },
				{ "slug": "brass", "name": "Brass", "color": "#C9A45C" }
			]
		},
		"typography": {
			"fontFamilies": [
				{ "slug": "display", "name": "Oswald", "fontFamily": "'Oswald', 'Arial Narrow', sans-serif" },
				{ "slug": "body", "name": "IBM Plex Sans", "fontFamily": "'IBM Plex Sans', Arial, sans-serif" },
				{ "slug": "serif", "name": "IBM Plex Serif", "fontFamily": "'IBM Plex Serif', Georgia, serif" }
			]
		},
		"layout": { "contentSize": "760px", "wideSize": "1240px" }
	},
	"styles": {
		"color": { "background": "var:preset|color|base", "text": "var:preset|color|contrast" },
		"typography": { "fontFamily": "var:preset|font-family|body", "fontSize": "17px", "lineHeight": "1.6" },
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "600", "letterSpacing": "0.02em", "lineHeight": "1.2" },
				"color": { "text": "var:preset|color|contrast" }
			},
			"link": {
				"color": { "text": "var:preset|color|brass" },
				":hover": { "color": { "text": "var:preset|color|contrast" } }
			},
			"button": {
				"color": { "background": "var:preset|color|accent", "text": "#ffffff" },
				"border": { "radius": "4px" },
				"typography": { "fontFamily": "var:preset|font-family|display", "letterSpacing": "0.06em", "textTransform": "uppercase" },
				":hover": { "color": { "background": "#7E1A21", "text": "#ffffff" } }
			}
		},
		"blocks": {
			"core/separator": { "color": { "background": "var:preset|color|border", "text": "var:preset|color|border" } }
		}
	}
}
