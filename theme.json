{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Paper", "color": "#F6F3EC" },
				{ "slug": "surface", "name": "White", "color": "#FFFFFF" },
				{ "slug": "ink", "name": "Black", "color": "#0B0B0C" },
				{ "slug": "ink-2", "name": "Charcoal", "color": "#16171A" },
				{ "slug": "contrast", "name": "Text", "color": "#1C1A17" },
				{ "slug": "muted", "name": "Muted text", "color": "#6B655C" },
				{ "slug": "line", "name": "Line", "color": "#E3DCCD" },
				{ "slug": "gold", "name": "Gold", "color": "#C9A24A" },
				{ "slug": "gold-light", "name": "Light gold", "color": "#E3C77A" },
				{ "slug": "gold-dark", "name": "Dark gold", "color": "#8A6D2C" }
			]
		},
		"typography": {
			"fontFamilies": [
				{ "slug": "display", "name": "Cinzel", "fontFamily": "'Cinzel', 'Times New Roman', serif" },
				{ "slug": "body", "name": "Source Sans 3", "fontFamily": "'Source Sans 3', 'Helvetica Neue', Arial, sans-serif" }
			]
		},
		"layout": { "contentSize": "780px", "wideSize": "1280px" }
	},
	"styles": {
		"color": { "background": "var:preset|color|base", "text": "var:preset|color|contrast" },
		"typography": { "fontFamily": "var:preset|font-family|body", "fontSize": "17px", "lineHeight": "1.6" },
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "700", "letterSpacing": "0.02em", "lineHeight": "1.15" },
				"color": { "text": "var:preset|color|ink" }
			},
			"link": {
				"color": { "text": "var:preset|color|gold-dark" },
				":hover": { "color": { "text": "var:preset|color|ink" } }
			},
			"button": {
				"color": { "background": "var:preset|color|gold", "text": "var:preset|color|ink" },
				"border": { "radius": "3px" },
				"typography": { "fontFamily": "var:preset|font-family|body", "fontWeight": "700", "letterSpacing": "0.08em", "textTransform": "uppercase", "fontSize": "0.9rem" },
				":hover": { "color": { "background": "var:preset|color|gold-light", "text": "var:preset|color|ink" } }
			}
		},
		"blocks": {
			"core/separator": { "color": { "background": "var:preset|color|line", "text": "var:preset|color|line" } }
		}
	}
}
